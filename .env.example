# Optional: TRON / Bitcoin (WIF) / Solana (base58) keys, own RPCs, a TronGrid API key.
HASHLOCK_TRON_KEY=
HASHLOCK_BTC_KEY=
HASHLOCK_SOLANA_KEY=
HASHLOCK_EVM_RPC=
HASHLOCK_TRON_HOST=
HASHLOCK_TRON_API_KEY=
